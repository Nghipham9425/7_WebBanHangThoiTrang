    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<link href="~/Content/Mystyle/admin.css" rel="stylesheet" />
<style>
    a {
        text-decoration: none; /* Loại bỏ gạch chân */
        color: cornflowerblue;
    }
</style>
<h2 class="title-top">CHI TIẾT DANH MỤC</h2>
@Html.Partial("PV_DeleteDetailsCategory")
<p>
