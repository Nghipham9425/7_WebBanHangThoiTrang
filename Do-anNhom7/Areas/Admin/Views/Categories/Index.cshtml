@model IEnumerable<Do_anNhom7.Models.Category>

@{
    ViewBag.Title = "Danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<link href="~/Content/Mystyle/admin.css" rel="stylesheet" />
<style>
    a {
        text-decoration: none; /* Loại bỏ gạch chân */
        color:cornflowerblue;
    }
</style>
<h2 class="title-top">DANH SÁCH DANH MỤC SẢN PHẨM</h2>

<p>
    @Html.ActionLink("Tạo mới", "Create", "", new {@class="btn btn-dark btn-sm"})
</p>
<table class="table text-bg-light col-lg-8">
    <tr>
        <th class="bg-dark text-light opacity-75">
            @Html.DisplayNameFor(model => model.CategoryID)
        </th>
        <th class="bg-dark text-light opacity-75">
            @Html.DisplayNameFor(model => model.CategoryName)
        </th>
        <th class="bg-dark text-light opacity-75"></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.CategoryID)
        </td>
        <td>
            @Html.DisplayFor(modelItem =>item.CategoryName)
        </td>
        <td>
            @Html.ActionLink("Chỉnh sửa", "Edit", new { CategoryID = item.CategoryID }, new { @class = "btn btn-primary btn-sm" }) |
            @Html.ActionLink("Chi tiết", "Details", new { CategoryID = item.CategoryID }, new { @class = "btn btn-info btn-sm" }) |
            @Html.ActionLink("Xóa", "Delete", new { CategoryID = item.CategoryID }, new { @class = "btn btn-danger btn-sm" })
        </td>
    </tr>
}

</table>
