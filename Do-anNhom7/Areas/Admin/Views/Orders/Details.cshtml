@model Do_anNhom7.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<link href="~/Content/Mystyle/styleDetailforOrders.css" rel="stylesheet" />
<h2 class="order-details-title">Chi tiết đơn hàng</h2>
<div class="order-details">
    <div class="order-info">
        <strong>Mã đơn hàng:</strong> @Html.DisplayFor(model => model.OrderID)
    </div>
    <div class="order-info">
        <strong>Ngày đặt:</strong> @Html.DisplayFor(model => model.OrderDate)
    </div>
    <div class="order-info">
        <strong>Tổng cộng:</strong> @Html.DisplayFor(model => model.TotalAmount)
    </div>
    <div class="order-info">
        <strong>Trạng thái thanh toán:</strong> @Html.DisplayFor(model => model.PaymentStatus)
    </div>
    <div class="order-info">
        <strong>Địa chỉ giao hàng:</strong> @Html.DisplayFor(model => model.ShippingAddress)
    </div>
    <div class="order-info">
        <strong>Phương thức giao hàng:</strong> @Html.DisplayFor(model => model.DeliveryMethod)
    </div>
    <div class="order-info">
        <strong>Phương thức thanh toán:</strong> @Html.DisplayFor(model => model.PaymentMethod)
    </div>
    <div class="order-info customer-name">
        <strong>Tên khách hàng:</strong> @Html.DisplayFor(model => model.Customer.CustomerName)
    </div>
    <div class="order-info">
        <strong>Username:</strong> @Html.DisplayFor(model => model.Customer.Username)
    </div>
</div>


<h3 class="mt-5 text-center">Chi tiết sản phẩm</h3>
<table class="table table-bordered table-hover text-center">
    <thead class="thead-light">
        <tr>
            <th>Hình ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.OrderDetails)
        {
            <tr>
                <td>
                    <img src="@Url.Content("~/Content/img-sp/" + item.Product.ProductImage)"
                         alt="@item.Product.ProductName"
                         class="img-thumbnail" />
                </td>
                <td>@item.Product.ProductName</td>
                <td>@item.Quantity</td>
                <td>@string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.UnitPrice)</td>
                <td>
                    @(item.TotalPrice.HasValue ?
                            string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.TotalPrice.Value)
                            : "Không xác định")
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<p class="text-center">
    @Html.ActionLink("Trở lại danh sách", "Index", null, new { @class = "btn btn-primary" })
</p>
