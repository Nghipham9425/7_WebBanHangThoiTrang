@model Do_anNhom7.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc
<link href="~/Content/Mystyle/admin.css" rel="stylesheet" />


<p class="text-right">
    @Html.ActionLink("Tạo mới", "Create", null, new { @class = "btn btn-dark btn-sm" })
</p>

@if (Model.Products != null && Model.Products.Any())  //any la co it nhat 1 sp
{
    <table class="table text-bg-light col-lg-8">
        <thead>
            <tr>
                <th class="bg-dark text-light opacity-75">Hình ảnh</th>
                <th class="bg-dark text-light opacity-75">Tên sản phẩm</th>
                <th class="bg-dark text-light opacity-75">Đơn giá</th>
                <th class="bg-dark text-light opacity-75">Danh mục</th>
                <th class="bg-dark text-light opacity-75"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td><img src="~/Content/img-sp/@product.ProductImage" alt="@product.ProductName" style="width: 200px; height: auto;" /></td>
                    <td>@product.ProductName</td>
                    <td>@product.ProductPrice</td>
                    <td>@product.Category.CategoryName</td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = product.ProductID }, new { @class = "btn btn-primary btn-sm" }) |
                        @Html.ActionLink("Chi tiết", "Details", new { id = product.ProductID }, new { @class = "btn btn-info btn-sm" }) |
                        @Html.ActionLink("Xoá", "Delete", new { id = product.ProductID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <!--Hiển thị phân trang-->
    <div class="pagination-container"> @*tham số đầu là danh sách sp đã đc phân trang,tham số 2 page là số trang hiện tại mà người dùng yêu cầu,
                                           URL.Action(Tạo yêu cầu gửi tới Index.page số trang hiện tại,searchTerm từ khóa tìm kiếm hiện tại,
                                           min price,max price các khoảng giá cx đc giữ lại khi chuyển ttang,thứ tự sắp xếp cũng đc giữ lại*@
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new {page, searchTerm=Model.SearchTerm,
        minPrice=Model.MinPrice,maxPrice=Model.MaxPrice,sortOrder=Model.SortOrder}))
    </div>
}
else
{
    <p>Không tìm được sản phẩm phù hợp.</p>
}
