@model Do_anNhom7.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<link href="~/Content/Mystyle/admin.css" rel="stylesheet" />
<h2 class="text-center">Xóa sản phẩm</h2>

<h3 class="text-center">Bạn muốn xóa sản phẩm này chứ ?</h3>
<div class="text-center">
    <hr />
    @Html.Partial("PV_DeleteDetailPro")
    

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="form-actions no-color">
            <input type="submit" value="Xóa" class="btn btn-danger" />
            @Html.ActionLink("Trở lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    }
</div>
