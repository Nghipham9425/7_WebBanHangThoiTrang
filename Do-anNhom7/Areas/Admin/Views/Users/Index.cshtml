@model IEnumerable<Do_anNhom7.Models.User>

@{
    ViewBag.Title = "Danh sách người dùng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<link href="~/Content/Mystyle/admin.css" rel="stylesheet" />
<style>
    a {
        text-decoration: none;
        color: cornflowerblue;
    }
</style>

<h2 class="title-top">DANH SÁCH NGƯỜI DÙNG</h2>

<p>
    @Html.ActionLink("Tạo mới", "Create", "", new { @class = "btn btn-dark btn-sm" })
</p>

<!-- Bảng người dùng -->
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th class="bg-dark text-light opacity-75">Tên người dùng</th>
            <th class="bg-dark text-light opacity-75">Vai trò</th>
            <th class="bg-dark text-light opacity-75"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Username)</td>
                <td>@Html.DisplayFor(modelItem => item.UserRole)</td>
                <td>
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.Username }, new { @class = "btn btn-info btn-sm" }) |
                    @Html.ActionLink("Chỉnh sửa", "Edit", new { id = item.Username }, new { @class = "btn btn-warning btn-sm" }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.Username }, new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>

