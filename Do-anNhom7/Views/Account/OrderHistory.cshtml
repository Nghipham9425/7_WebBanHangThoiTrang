@model IEnumerable<Do_anNhom7.Models.Order>

@{
    ViewBag.Title = "Lịch sử đặt hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f7f8fa;
        margin: 0;
        padding: 0;
    }

    h2 {
        margin-bottom: 20px;
        color: #333;
    }

    .table {
        width: 100%;
        margin-bottom: 20px;
        border-collapse: collapse;
        background-color: #fff;
    }

        .table th, .table td {
            text-align: center;
            vertical-align: middle;
            padding: 12px;
            border: 1px solid #ddd;
        }

        .table th {
            background-color: #f4f4f4;
            font-weight: bold;
            color: #555;
        }

        .table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .table tr:hover {
            background-color: #f1f1f1;
        }

    .btn-primary {
        background-color: #007bff;
        color: #fff;
        border: none;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: bold;
        text-decoration: none;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .text-center {
        text-align: center;
    }

    .no-orders {
        text-align: center;
        padding: 20px;
        font-size: 16px;
        color: #555;
    }
</style>

<h2 class="text-center">Lịch sử đặt hàng</h2>

<table class="table">
    <thead>
        <tr>
            <th>Mã đơn hàng</th>
            <th>Ngày đặt hàng</th>
            <th>Tổng tiền</th>
            <th>Trạng thái thanh toán</th>
            <th>Phương thức thanh toán</th>
            <th>Chi tiết</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderID</td>
                    <td>@(order.OrderDate.HasValue ? order.OrderDate.Value.ToString("HH:mm dd/MM/yyyy") : "Không xác định")</td>
                    <td>
                        @(order.TotalAmount.HasValue ?
                            string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", order.TotalAmount.Value)
                            : "Không xác định")
                    </td>
                    <td>@(!string.IsNullOrEmpty(order.PaymentStatus) ? order.PaymentStatus : "Không xác định")</td>
                    <td>@(!string.IsNullOrEmpty(order.PaymentMethod) ? order.PaymentMethod : "Không xác định")</td>
                    <td>
                        <a href="@Url.Action("OrderDetails", "Order", new { id = order.OrderID })" class="btn btn-primary btn-sm">Xem chi tiết</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="no-orders">Bạn chưa có đơn hàng nào.</td>
            </tr>
        }
    </tbody>
</table>
