@model Do_anNhom7.Models.Customer

@{
    ViewBag.Title = "Chi tiết thông tin người dùng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    /* Tiêu đề */
    .tieude {
        text-align: center;
        color: darkred;
        font-family: 'Arial', sans-serif;
        margin-bottom: 30px;
        font-size: 28px; /* Tăng kích thước font */
        font-weight: bold;
    }

    /* Phần thông tin người dùng */
    .user-info {
        font-size:20px;
        font-family: 'Arial', sans-serif;
        line-height: 1.8;
        color: black; /* Màu chữ mềm mại hơn */
        padding: 20px;
        background-color: #f4f4f4; /* Màu nền nhẹ nhàng */
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

        /* Khoảng cách giữa các dòng thông tin người dùng */
        .user-info div {
            margin-bottom: 20px;
        }

    /* Tên và thông tin người dùng */
    strong {
        color: #007bff; /* Vẫn giữ màu xanh đậm nhưng dịu nhẹ */
        font-weight: bold;
    }

    /* Nút chỉnh sửa */
    .btn-warning {
        background-color: #ffcc00; /* Màu vàng nhạt hơn */
        border: none;
        color: black;
        padding: 12px 25px;
        text-decoration: none;
        border-radius: 5px;
        font-size: 16px;
        display: inline-block;

    }

        /* Thêm hiệu ứng hover cho nút */
        .btn-warning:hover {
            background-color: #e6b800;
            color:white;
         
        }

    /* Cảnh báo khi chưa đăng nhập */
    .no-login {
        text-align: center;
        font-size: 20px; /* Tăng kích thước chữ cho dễ nhìn */
        color: #f44336; /* Màu đỏ dịu nhẹ */
        margin-top: 30px;
        font-weight: bold;
    }
</style>

<h2 class="tieude">Chi tiết thông tin người dùng</h2>

@if (Session["Username"] != null)
{
    <div class="user-info">
        <div>
            <strong>Họ và tên: </strong> @Model.CustomerName
        </div>
        <div>
            <strong>Số điện thoại: </strong> @Model.CustomerPhone
        </div>
        <div>
            <strong>Email: </strong> @Model.CustomerEmail
        </div>
        <div>
            <strong>Địa chỉ: </strong> @Model.CustomerAddress
        </div>

        <!-- Thêm liên kết để chỉnh sửa thông tin -->
        <div>
            <a href="@Url.Action("Edit", "Account")" class="btn btn-warning">Chỉnh sửa thông tin</a>
        </div>
    </div>
}
else
{
    <div class="no-login">
        Bạn chưa đăng nhập. Vui lòng đăng nhập để xem thông tin chi tiết.
    </div>
}
