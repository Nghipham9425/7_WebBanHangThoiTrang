@model Do_anNhom7.Models.Customer

@{
    ViewBag.Title = "Chỉnh sửa thông tin người dùng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    /* Tiêu đề */
    h2 {
        text-align: center;
        font-family: 'Arial', sans-serif;
        color: darkred;
        margin-bottom: 30px;
        font-size: 28px;
        font-weight: bold;
    }

    /* Form chỉnh sửa */
    .form-container {
        width: 50%;
        margin: 0 auto;
        padding: 30px;
        background-color: #f9f9f9;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

        .form-container div {
            margin-bottom: 20px;
        }

        .form-container label {
            font-size: 16px;
            font-weight: bold;
            color: #333;
        }

        .form-container .form-control {
            width: 100%;
            padding: 12px;
            margin-top: 5px;
            border-radius: 5px;
            border: 1px solid #ccc;
            font-size: 16px;
        }

    /* Nút lưu thay đổi */
    .btn-primary {
        background-color: #007bff;
        border: none;
        color: white;
        padding: 12px 25px;
        font-size: 16px;
        border-radius: 5px;
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

        /* Hiệu ứng hover cho nút */
        .btn-primary:hover {
            background-color: #0056b3;
            transform: scale(1.05);
        }
</style>

<h2>Chỉnh sửa thông tin người dùng</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-container">
        <div>
            <label for="CustomerName">Họ và tên:</label>
            @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control" })
        </div>

        <div>
            <label for="CustomerPhone">Số điện thoại:</label>
            @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control" })
        </div>

        <div>
            <label for="CustomerEmail">Email:</label>
            @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control" })
        </div>

        <div>
            <label for="CustomerAddress">Địa chỉ:</label>
            @Html.TextBoxFor(m => m.CustomerAddress, new { @class = "form-control" })
        </div>

        <div>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        </div>
    </div>
}
