@model Do_anNhom7.Models.ViewModel.ProductDetailsVM
    @using PagedList.Mvc
<link href="~/Content/Mystyle/customerHome.css" rel="stylesheet" />

<!--Hiển thị ds sp-->
@if (Model.TopProducts != null && Model.TopProducts.Any())
{
    <section class="container-fluid listProduct">
        <h4 style="font-weight:bold">Sản phẩm bán chạy</h4>
        <ul class="list-container">
            @foreach (var product in Model.TopProducts)
            {
                <li class="lproduct-item">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="~/Content/img-sp/@product.ProductImage" alt="@product.ProductName" />
                        </a>
                    </div>
                    <div>
                        <h5>@Html.DisplayFor(ModelItem => product.ProductName)</h5>
                        <p class="prodSale">@Html.DisplayFor(modelItem => product.ProductPrice)</p>
                    </div>
                </li> 
            }
        </ul>
    </section>
    <!--Hien thi phan trang-->
    <div class="pagination-container">
        @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetails", new
   {
       id = Model.product.ProductID,
       quantity = Model.quantity,
            page
        }))
    </div>
}



